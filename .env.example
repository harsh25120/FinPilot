# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# --- Application ---
PROJECT_NAME=FinPilot
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# --- Database ---
# Used directly by the API when running it outside Docker (e.g. `uvicorn app.main:app`).
# When running via `docker compose up`, the api service overrides this to point at
# the "db" container instead of localhost — see docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://finpilot:finpilot@localhost:5432/finpilot

# Optional: point this at a separate database (name must contain "test") to run
# the test suite without touching your development data. Falls back to
# DATABASE_URL if unset — in which case tests will refuse to run unless that
# URL's database name already contains "test".
TEST_DATABASE_URL=postgresql+psycopg2://finpilot:finpilot@localhost:5432/finpilot_test

# Credentials used by the docker-compose "db" (Postgres) container itself.
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=finpilot
POSTGRES_DB=finpilot

# --- Security ---
# Generate a real value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# "*" allows all origins. Otherwise, provide a comma-separated list, e.g.:
# BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
BACKEND_CORS_ORIGINS=*
